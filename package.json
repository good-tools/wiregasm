{
  "name": "@goodtools/wiregasm",
  "version": "1.9.1",
  "description": "Packet Analyzer powered by Wireshark compiled for WebAssembly",
  "source": "src/index.ts",
  "main": "dist/main.js",
  "types": "dist/types.d.ts",
  "module": "dist/module.js",
  "scripts": {
    "dev": "parcel watch",
    "build:emscripten": "make docker",
    "build:emscripten-local": "make -j\"$(nproc)\"",
    "build": "parcel build && npm run copy-assets",
    "copy-assets": "cp built/bin/wiregasm.* dist/",
    "test": "jest --coverage",
    "lint": "biome ci . && npm run lint:cpp",
    "lint:cpp": "git ls-files 'lib/wiregasm/*.cpp' 'lib/wiregasm/*.h' | xargs clang-format --dry-run --Werror",
    "fix": "biome check --write . && git ls-files 'lib/wiregasm/*.cpp' 'lib/wiregasm/*.h' | xargs clang-format -i",
    "size-check": "node scripts/size-check.mjs"
  },
  "keywords": [
    "pcap",
    "packet",
    "analyzer",
    "wireshark",
    "wasm"
  ],
  "homepage": "https://github.com/good-tools/wiregasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-tools/wiregasm.git"
  },
  "license": "GPLV2",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@parcel/packager-ts": "^2.8.2",
    "@parcel/transformer-typescript-types": "^2.8.2",
    "@types/jest": "^29.2.5",
    "@types/node": "^22.19.11",
    "@types/pako": "^2.0.0",
    "@wasm-fmt/clang-format": "23.1.1",
    "jest": "^29.3.1",
    "pako": "^2.1.0",
    "parcel": "^2.8.2",
    "ts-jest": "^29.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "coveragePathIgnorePatterns": [
      "<rootDir>/built/bin"
    ]
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  }
}

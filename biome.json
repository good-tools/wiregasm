{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "e2e/**",
      "lib/wiregasm/ext/**",
      "*.json",
      "!package.json",
      "!package-lock.json",
      "!e2e/.pkg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["lib/wiregasm/ext/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off",
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ]
}
